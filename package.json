{
  "name": "codex-gitee-code-review",
  "version": "0.1.0",
  "description": "Independent Gitee pull request review plugin for Codex",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "audit:publish": "node scripts/audit-publication.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "diff": "9.0.0",
    "lucide": "1.52.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
