{
  "mcpServers": {
    "gitee-code-review": {
      "command": "/bin/sh",
      "args": ["-c", "exec \"${CODEX_MCP_NODE_PATH:-node}\" ./dist/server.mjs"],
      "cwd": ".",
      "env_vars": ["PATH", "HOME", "CODEX_HOME", "CODEX_MCP_NODE_PATH", "GITEE_TOKEN", "HTTPS_PROXY", "HTTP_PROXY", "NO_PROXY", "NODE_EXTRA_CA_CERTS"],
      "tool_timeout_sec": 120
    }
  }
}
